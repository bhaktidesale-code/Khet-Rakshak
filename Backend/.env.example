NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# PostgreSQL connection. Keep the real value in an ignored .env or secret manager.
DATABASE_URL=postgres://<user>:<password>@<host>:5432/<database>
# Set true for remote PostgreSQL/TLS; confirmed production migrations require it.
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Must be the same Firebase project configured in the frontend.
FIREBASE_PROJECT_ID=your-firebase-project-id

# Local option: paste the complete Firebase Admin service-account JSON as one
# environment value. Keep it private; never use a VITE_ prefix for this value.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Alternative to FIREBASE_SERVICE_ACCOUNT_JSON: absolute path to an Admin SDK
# credential file, or use gcloud ADC via `gcloud auth application-default login`.
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\service-account.json
